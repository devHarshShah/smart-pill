generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  ownedDevices  Device[]        @relation("DeviceOwner")
  lockedDevices Device[]        @relation("DeviceLockOwner")
  commands      DeviceCommand[]
}

model Device {
  id                  String    @id @default(uuid())
  hardwareId          String    @unique
  deviceSecret        String
  label               String?
  ownerUserId         String?
  lockedByUserId      String?
  pairedAt            DateTime?
  lastPhysicalResetAt DateTime?
  createdAt           DateTime  @default(now())

  owner         User?                @relation("DeviceOwner", fields: [ownerUserId], references: [id])
  lockOwner     User?                @relation("DeviceLockOwner", fields: [lockedByUserId], references: [id])
  commands      DeviceCommand[]
  events        DeviceEvent[]
  doses         DeviceDose[]
  runtimeStatus DeviceRuntimeStatus?
}

model DeviceCommand {
  id        String   @id @default(uuid())
  deviceId  String
  userId    String
  command   String
  payload   Json?
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([deviceId, createdAt])
  @@index([userId])
}

model DeviceRuntimeStatus {
  id            String   @id @default(uuid())
  deviceId      String   @unique
  hardwareId    String
  wifiConnected Boolean
  ip            String?
  rssi          Int?
  setupDone     Boolean
  setupMismatch Boolean  @default(false)
  detectedPills Int?
  pillWeight    Float?
  threshold     Float?
  confirmReads  Int?
  currentPills  Int?
  totalPills    Int?
  updatedAt     DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id])

  @@index([hardwareId])
}

model DeviceEvent {
  id        String   @id @default(uuid())
  deviceId  String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt])
}

model DeviceDose {
  id               String    @id @default(uuid())
  deviceId         String
  pillName         String
  scheduledAt      DateTime
  requiredPills    Int       @default(1)
  alertTriggeredAt DateTime?
  lastReminderAt   DateTime?
  reminderCount    Int       @default(0)
  completedAt      DateTime?
  takenPills       Int?
  overdoseDetected Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, scheduledAt])
  @@index([deviceId, completedAt])
}
